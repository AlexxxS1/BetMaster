{
  "name": "betmaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c teal,orange \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=shared --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5180",
    "ingest": "node --disable-warning=ExperimentalWarning --import tsx server/cli.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test server/model.test.ts server/analyze.test.ts server/sources.test.ts server/db.test.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/outfit": "^5.2.5",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
